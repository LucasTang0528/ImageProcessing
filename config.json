{
  "_comment": "FreshSight single source of truth. Every path is relative to the project root unless it is already absolute. Editing this file is the ONLY supported way to change experimental parameters.",

  "seed": 42,

  "paths": {
    "project_root": ".",
    "primary_root": "data/primary",
    "generalisation_root": "data/generalisation",
    "robustness_root": "data/robustness",
    "results_root": "results",
    "cache_root": "results/cache"
  },

  "datasets": {
    "primary": {
      "classes": ["UnripeApple", "RipeApple", "RottenApple"],
      "display_names": ["Unripe", "Ripe", "Rotten"]
    },
    "generalisation": {
      "classes": ["FreshApple", "RottenApple"],
      "display_names": ["Fresh", "Rotten"]
    },
    "robustness": {
      "classes": ["Good", "Bad", "Mixed"],
      "display_names": ["Good", "Bad", "Mixed"]
    },
    "image_extensions": [".jpg", ".jpeg", ".png", ".bmp", ".tif", ".tiff", ".webp"]
  },

  "preprocess": {
    "resize": [224, 224],
    "gaussian_kernel": [5, 5],
    "gaussian_sigma": 0,
    "clahe_clip_limit": 2.0,
    "clahe_tile_grid": [8, 8]
  },

  "segmentation": {
    "method": "grabcut",
    "close_kernel": [5, 5],
    "min_mask_fraction": 0.05,
    "max_mask_fraction": 0.95,
    "polarity": "auto",
    "on_failure": "exclude",
    "fill_holes": true,
    "cache_masks": true,
    "grabcut": {
      "iterations": 5,
      "border_scale": 0.06,
      "core_scale": 0.28,
      "probable_scale": 0.78,
      "min_seed_growth": 1.5
    }
  },

  "partition": {
    "test_size": 0.2,
    "cv_folds": 5,
    "shuffle": true
  },

  "augmentation": {
    "enabled": true,
    "variants_per_image": 3,
    "horizontal_flip": true,
    "rotation_degrees": 15.0,
    "brightness_jitter": 0.2
  },

  "classifier": {
    "kernel": "rbf",
    "C": 1.0,
    "gamma": "scale",
    "probability": true
  },

  "t1_colour": {
    "_comment": "T1 is the MPEG-7 Dominant Colour Descriptor. Thresholds in true CIE units except specular_lightness, which is OpenCV 8-bit L because CIE L* cannot exceed 100: specular L>=240 is L*>94, decay_lightness_max 45 is 8-bit 115, and chroma/a* values are unscaled between the encodings.",
    "n_colours": 4,
    "space": "LAB",
    "exclude_specular": true,
    "specular_lightness": 240.0,
    "specular_chroma": 12.0,
    "sample_size": 5000,
    "coherency_min_fraction": 0.01,
    "green_a_max": 0.0,
    "decay_chroma_max": 25.0,
    "decay_lightness_max": 45.0,
    "blocks": "ABC"
  },

  "t2_glcm": {
    "levels": 32,
    "distances": [1, 2],
    "angles_deg": [0, 45, 90, 135],
    "angle_averaged": false
  },

  "t3_morphological": {
    "_comment": "Multiscale morphological descriptors. LBP was dropped: it is outside the BMDS2133 syllabus, and its hue-deviation blemish stage reused the colour evidence T1 is built on. hue_deviation/saturation_deviation/value_deviation survive only as the E3.4 comparator that measures what dropping it cost. mm_per_px stays 1.0 while no calibration stage exists, so blemish areas are reported in pixels.",
    "r_max": 7,
    "se_shape": "ellipse",
    "tophat_radius": 9,
    "min_blemish_area": 15,
    "blemish_method": "bth_otsu",
    "fixed_threshold": 30,
    "exclude_poles": false,
    "pole_fraction": 0.15,
    "mm_per_px": 1.0,
    "hue_deviation": 20.0,
    "saturation_deviation": 60.0,
    "value_deviation": 60.0
  },

  "ingest": {
    "_comment": "Dataset staging only. Nothing here affects the experiment; scripts/ingest_dataset.py is the sole reader. class_aliases lets the survey recognise a renamed publisher folder without editing the script.",
    "local_source": "~/Downloads/archive",
    "kaggle_slug": "dudinurdiyansah/fruit-ripeness-dataset",
    "ignore_dirs": ["test", "val", "valid", "validation"],
    "match_threshold": 0.6,
    "review_threshold": 0.3,
    "class_aliases": {
      "UnripeApple": ["unripe apple", "unripe_apple", "green apple", "raw apple"],
      "RipeApple": ["ripe apple", "ripe_apple", "good apple"],
      "RottenApple": ["rotten apple", "rotten_apple", "bad apple", "spoiled apple"]
    }
  },

  "sanity_check": {
    "images_per_class": 12
  }
}
