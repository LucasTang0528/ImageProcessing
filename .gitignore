# Datasets are large and licensed separately: never committed.
data/primary/**
data/generalisation/**
data/robustness/**
data/candidate*/**
!data/**/.gitkeep

# Downloaded dataset archives, staged before extraction. The extracted folders
# above are ignored, but the archive itself sits beside them and is not, so it
# would otherwise be committed by a plain "git add data".
data/*.zip
data/*.tar
data/*.tar.gz
data/*.tgz

# Generated results. Metrics travel with commits; heavy artefacts do not.
# Order matters: git will not descend into an excluded directory, so the
# directories must be re-included before any pattern inside them can match.
results/**
!results/.gitkeep
!results/**/
!results/**/*.csv
!results/**/*.json
!results/**/*.txt
# Caches and images are regenerable and large, so they stay out even though
# they sit under a re-included directory.
results/cache/**
results/**/*.png
results/**/*.jpg

# Credentials - never commit an API token.
# NOTE: deliberately NOT a blanket "*.json". config.json is the experiment's
# single source of truth and must stay tracked; a blanket rule would hide it
# from every teammate who cloned the repo fresh.
.kaggle/
**/.kaggle/
kaggle.json
**/kaggle.json
*credential*.json
*credentials*.json
*secret*.json
*secrets*.json
*token*.json
service-account*.json
service_account*.json
.env
.env.*

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Editors and OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# Generated results site (rebuild with scripts/build_site.py)
site/
