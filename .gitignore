# Datasets are large and licensed separately: never committed.
data/primary/**
data/generalisation/**
data/robustness/**
data/candidate*/**
!data/**/.gitkeep

# Downloaded dataset archives, staged before extraction. The extracted folders
# above are ignored, but the archive itself sits beside them and is not, so it
# would otherwise be committed by a plain "git add data".
data/*.zip
data/*.tar
data/*.tar.gz
data/*.tgz

# Generated results.
#
# The tables are tracked, the pictures are not. A teammate who clones the
# repository has to be able to read the numbers the report quotes without
# re-running a two-hour pipeline, and every CSV in here is a few kilobytes.
# The PNGs are the same information rendered, and they are not: confusion
# matrices and visual panels are regenerated by build_report.py and
# build_visuals.py from the CSVs that are tracked.
#
# run_config.json and run_metadata.json are tracked with them deliberately.
# A CSV of accuracies is not interpretable without the seed, the partition, the
# image count and the dataset's audit verdict that produced it, and those live
# in the JSON beside it. The credential rules further down still win, because
# a later pattern takes precedence: results/anything_secret.json stays ignored.
results/**
!results/**/
!results/*.csv
!results/*.txt
!results/*.json
!results/**/*.csv
!results/**/*.txt
!results/**/*.json
!results/.gitkeep

# Cached masks and features are derived, large, and reproducible from the
# config. They are never tracked, whatever their extension.
results/cache/**

# Credentials - never commit an API token.
# NOTE: deliberately NOT a blanket "*.json". config.json is the experiment's
# single source of truth and must stay tracked; a blanket rule would hide it
# from every teammate who cloned the repo fresh.
.kaggle/
**/.kaggle/
kaggle.json
**/kaggle.json
*credential*.json
*credentials*.json
*secret*.json
*secrets*.json
*token*.json
service-account*.json
service_account*.json
.env
.env.*

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Editors and OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# Generated results site (rebuild with scripts/build_site.py)
site/
